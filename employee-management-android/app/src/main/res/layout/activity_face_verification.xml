<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- CameraX Front Camera Live Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Overlay Instructions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC0F172A"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tvFaceModeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Live Face Verification (Liveness Active)"
            android:textColor="@color/primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFaceEmployeeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Employee: EMP007"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Center Face Alignment Frame -->
    <View
        android:layout_width="250dp"
        android:layout_height="310dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_card_dark"
        android:alpha="0.22" />

    <!-- Bottom Status & Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#E60F172A"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvLivenessPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Step 1: Center your face inside the frame"
            android:textColor="@color/warning_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressLiveness"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="10"
            android:progressTint="@color/primary" />

        <Button
            android:id="@+id/btnCancelFace"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#334155"
            android:text="Cancel"
            android:textColor="#FFFFFF"
            android:textAllCaps="false" />
    </LinearLayout>

</FrameLayout>
